# Set these in Vercel Project Settings → Environment Variables. Never expose them with a VITE_ prefix.
RESEND_API_KEY=re_xxxxxxxxx
ENQUIRY_TO_EMAIL=meditalplacement@gmail.com
# Must be a sender address on a domain verified in Resend.
ENQUIRY_FROM_EMAIL=Medital Placement Enquiries <enquiries@yourdomain.com>
# Public production URL used when generating robots.txt and sitemap.xml during build.
SITE_URL=https://www.yourdomain.com
